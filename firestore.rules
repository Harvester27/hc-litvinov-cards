rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAccount() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function tipovackaAdmin() {
      return verifiedAccount()
        && request.auth.token.email == 'sanarycogames@outlook.cz';
    }

    function validScorerStakes(stakes) {
      return stakes is map
        && stakes.keys().hasAll([
          'jan-schubada', 'marian-dlugopolsky', 'lubos-coufal',
          'jan-hanus', 'jiri-salanda', 'none-listed'
        ])
        && stakes.keys().hasOnly([
          'jan-schubada', 'marian-dlugopolsky', 'lubos-coufal',
          'jan-hanus', 'jiri-salanda', 'none-listed'
        ])
        && stakes['jan-schubada'] is int
        && stakes['marian-dlugopolsky'] is int
        && stakes['lubos-coufal'] is int
        && stakes['jan-hanus'] is int
        && stakes['jiri-salanda'] is int
        && stakes['none-listed'] is int
        && stakes['jan-schubada'] >= 0
        && stakes['marian-dlugopolsky'] >= 0
        && stakes['lubos-coufal'] >= 0
        && stakes['jan-hanus'] >= 0
        && stakes['jiri-salanda'] >= 0
        && stakes['none-listed'] >= 0
        && stakes['jan-schubada'] + stakes['marian-dlugopolsky']
          + stakes['lubos-coufal'] + stakes['jan-hanus']
          + stakes['jiri-salanda'] + stakes['none-listed'] == 10;
    }

    function validCommentText(text) {
      return text is string && text.size() > 0 && text.size() <= 1000;
    }

    // Profiles may contain private data. The new client can only read its own
    // profile; trusted server code must create or change profile and game data.
    match /users/{uid}/profile/data {
      allow get: if verifiedAccount() && request.auth.uid == uid;
    }

    // A verified player may create one game profile with a zero starting balance.
    // Later balance changes require trusted server code.
    match /lancersCardsPlayers/{uid} {
      allow get: if verifiedAccount() && request.auth.uid == uid;

      allow create: if verifiedAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'playerName', 'teamName', 'balance', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'playerName', 'teamName', 'balance', 'createdAt'
        ])
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 2
        && request.resource.data.playerName.size() <= 32
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() >= 2
        && request.resource.data.teamName.size() <= 40
        && request.resource.data.balance is int
        && request.resource.data.balance == 0
        && request.resource.data.createdAt == request.time;
    }

    // The prediction game is an admin-only preview. Drafts are private to the
    // verified owner of the single approved email until public launch.
    match /tipovackaPreview/{uid} {
      allow get: if tipovackaAdmin() && request.auth.uid == uid;

      allow create, update: if tipovackaAdmin()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['roundId', 'picks', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['roundId', 'picks', 'updatedAt'])
        && request.resource.data.roundId == 'glacier-wolves-2026-09-26'
        && request.resource.data.picks is map
        && request.resource.data.picks.keys().hasAll([
          'outcome', 'scorer', 'topPoints', 'firstGoal', 'totalGoals'
        ])
        && request.resource.data.picks.keys().hasOnly([
          'outcome', 'scorer', 'topPoints', 'firstGoal', 'totalGoals'
        ])
        && request.resource.data.picks.outcome in ['lancers', 'wolves', 'draw']
        // Accept an old open tab during rollout; new drafts use six stakes.
        && (
          (
            request.resource.data.picks.scorer is string
            && request.resource.data.picks.scorer in [
              'jan-schubada', 'marian-dlugopolsky', 'lubos-coufal',
              'jan-hanus', 'jiri-salanda'
            ]
          )
          || validScorerStakes(request.resource.data.picks.scorer)
        )
        && request.resource.data.picks.topPoints in [
          'pavel-novak', 'marian-dlugopolsky', 'gustav-toman'
        ]
        && request.resource.data.picks.firstGoal in ['lancers', 'wolves']
        && request.resource.data.picks.totalGoals is int
        && request.resource.data.picks.totalGoals >= 0
        && request.resource.data.picks.totalGoals <= 30
        && request.resource.data.updatedAt == request.time;
    }

    // The prediction standings are still an admin-only preview. Entering the
    // game may add one zero-point row for the verified owner. Only trusted
    // server code may later change scores or the number of evaluated rounds.
    match /tipovackaStandings/{uid} {
      allow get, list: if tipovackaAdmin();

      allow create: if tipovackaAdmin()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'displayName', 'totalPoints', 'roundsPlayed', 'joinedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'totalPoints', 'roundsPlayed', 'joinedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints == 0
        && request.resource.data.roundsPlayed is int
        && request.resource.data.roundsPlayed == 0
        && request.resource.data.joinedAt == request.time;

      allow update: if tipovackaAdmin()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30;
    }

    // This is public output for future server-generated standings. Old client
    // code is not permitted to invent scores or rewards.
    match /leaderboard/{entryId} {
      allow get, list: if true;
    }

    // Article comments are public. A verified account may write only its own
    // text and may soft-delete its own comment. Likes are intentionally not
    // writable from the browser because the old counter can be forged.
    match /comments/{commentId} {
      allow get, list: if resource.data.isDeleted == false;

      allow create: if verifiedAccount()
        && request.resource.data.keys().hasAll([
          'articleId', 'userId', 'userDisplayName', 'userAvatar',
          'content', 'createdAt', 'editedAt', 'likes', 'likedBy', 'isDeleted'
        ])
        && request.resource.data.keys().hasOnly([
          'articleId', 'userId', 'userDisplayName', 'userAvatar',
          'content', 'createdAt', 'editedAt', 'likes', 'likedBy', 'isDeleted'
        ])
        && request.resource.data.articleId is string
        && request.resource.data.articleId.size() > 0
        && request.resource.data.articleId.size() <= 160
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() > 0
        && request.resource.data.userDisplayName.size() <= 40
        && request.resource.data.userAvatar == null
        && validCommentText(request.resource.data.content)
        && request.resource.data.createdAt == request.time
        && request.resource.data.editedAt == null
        && request.resource.data.likes == 0
        && request.resource.data.likedBy == []
        && request.resource.data.isDeleted == false;

      allow update: if verifiedAccount()
        && resource.data.userId == request.auth.uid
        && resource.data.isDeleted == false
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['content', 'editedAt'])
            && validCommentText(request.resource.data.content)
            && request.resource.data.editedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['isDeleted', 'deletedAt'])
            && request.resource.data.isDeleted == true
            && request.resource.data.deletedAt == request.time
          )
        );
    }

    // Everything else is denied by default, including packs, balance changes,
    // match state, marketplace listings, and old client-authored game progress.
  }
}
